{
  "$defs": {
    "OffsetUnit": {
      "description": "Варианты сдвига по дате",
      "enum": [
        "calendar_day",
        "business_day",
        "month",
        "quarter",
        "year"
      ],
      "title": "OffsetUnit",
      "type": "string"
    },
    "PaymentAmountType": {
      "description": "Как вводим amount - фикс сумма или процент или как-то еще (на будущее - остаток и т.д.)",
      "enum": [
        "fixed",
        "percentage"
      ],
      "title": "PaymentAmountType",
      "type": "string"
    },
    "PaymentTermAnchorDate": {
      "description": "Anchor date периода ценообразования",
      "enum": [
        "payment_period_start",
        "payment_period_end"
      ],
      "title": "PaymentTermAnchorDate",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Идентификатор объекта",
      "title": "Id",
      "ui:hidden": true
    },
    "payment_period": {
      "default": "month",
      "title": "Payment Period",
      "type": "string"
    },
    "date_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Offset"
    },
    "date_offset_unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/OffsetUnit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 100,
      "title": "Amount"
    },
    "amount_type": {
      "allOf": [
        {
          "$ref": "#/$defs/PaymentAmountType"
        }
      ],
      "default": "percentage"
    },
    "anchor_date": {
      "allOf": [
        {
          "$ref": "#/$defs/PaymentTermAnchorDate"
        }
      ],
      "default": "payment_period_end"
    }
  },
  "title": "PaymentTermModel",
  "type": "object"
}