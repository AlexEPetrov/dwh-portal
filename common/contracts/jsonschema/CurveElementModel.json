{
  "$defs": {
    "AveragingRuleFunction": {
      "description": "AGG функции, применяемые к набору значений",
      "enum": [
        "average",
        "sum",
        "median",
        "first",
        "last"
      ],
      "title": "AveragingRuleFunction",
      "type": "string"
    },
    "ColumnAggregationMode": {
      "enum": [
        "first_available",
        "all_available",
        "all_required"
      ],
      "title": "ColumnAggregationMode",
      "type": "string"
    },
    "CumulativeRule": {
      "description": "Конфигурация кумулятивной (stateful) агрегации для элемента индекса",
      "properties": {
        "func": {
          "enum": [
            "sum",
            "average",
            "max",
            "min",
            "loss_carry_forward"
          ],
          "title": "Func",
          "type": "string"
        },
        "reset_period": {
          "default": "year",
          "enum": [
            "year",
            "quarter",
            "month",
            "never"
          ],
          "title": "Reset Period",
          "type": "string"
        },
        "carry_years": {
          "default": 0,
          "title": "Carry Years",
          "type": "integer"
        }
      },
      "required": [
        "func"
      ],
      "title": "CumulativeRule",
      "type": "object"
    },
    "EmptyAveragingRule": {
      "description": "Осреднение отсутствует",
      "properties": {
        "func": {
          "allOf": [
            {
              "$ref": "#/$defs/AveragingRuleFunction"
            }
          ],
          "default": "average"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "selection_mode": {
          "allOf": [
            {
              "$ref": "#/$defs/ColumnAggregationMode"
            }
          ],
          "default": "first_available"
        },
        "cumulative_reset_period": {
          "anyOf": [
            {
              "enum": [
                "year",
                "quarter",
                "month",
                "never"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cumulative Reset Period"
        },
        "carry_years": {
          "default": 0,
          "title": "Carry Years",
          "type": "integer"
        },
        "type": {
          "const": "none",
          "default": "none",
          "enum": [
            "none"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "EmptyAveragingRule",
      "type": "object"
    },
    "FixedDatesAveragingRule": {
      "description": "Осреднение значений на фикс. диапахон дат",
      "properties": {
        "func": {
          "allOf": [
            {
              "$ref": "#/$defs/AveragingRuleFunction"
            }
          ],
          "default": "average"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "selection_mode": {
          "allOf": [
            {
              "$ref": "#/$defs/ColumnAggregationMode"
            }
          ],
          "default": "first_available"
        },
        "cumulative_reset_period": {
          "anyOf": [
            {
              "enum": [
                "year",
                "quarter",
                "month",
                "never"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cumulative Reset Period"
        },
        "carry_years": {
          "default": 0,
          "title": "Carry Years",
          "type": "integer"
        },
        "type": {
          "const": "fixed_range",
          "default": "fixed_range",
          "enum": [
            "fixed_range"
          ],
          "title": "Type",
          "type": "string"
        },
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        }
      },
      "required": [
        "date_from",
        "date_to"
      ],
      "title": "FixedDatesAveragingRule",
      "type": "object"
    },
    "OffsetAveragingRule": {
      "description": "Осреднение со сдвигом относительно даты оценки",
      "properties": {
        "func": {
          "allOf": [
            {
              "$ref": "#/$defs/AveragingRuleFunction"
            }
          ],
          "default": "average"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "selection_mode": {
          "allOf": [
            {
              "$ref": "#/$defs/ColumnAggregationMode"
            }
          ],
          "default": "first_available"
        },
        "cumulative_reset_period": {
          "anyOf": [
            {
              "enum": [
                "year",
                "quarter",
                "month",
                "never"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cumulative Reset Period"
        },
        "carry_years": {
          "default": 0,
          "title": "Carry Years",
          "type": "integer"
        },
        "type": {
          "const": "offset",
          "default": "offset",
          "enum": [
            "offset"
          ],
          "title": "Type",
          "type": "string"
        },
        "offset_unit": {
          "allOf": [
            {
              "$ref": "#/$defs/OffsetUnit"
            }
          ],
          "default": "month"
        },
        "offset_from": {
          "default": -3,
          "title": "Offset From",
          "type": "integer"
        },
        "offset_to": {
          "default": -1,
          "title": "Offset To",
          "type": "integer"
        },
        "offset_point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "valuation_date",
          "title": "Offset Point"
        }
      },
      "title": "OffsetAveragingRule",
      "type": "object"
    },
    "OffsetUnit": {
      "description": "Варианты сдвига по дате",
      "enum": [
        "calendar_day",
        "business_day",
        "month",
        "quarter",
        "year"
      ],
      "title": "OffsetUnit",
      "type": "string"
    }
  },
  "description": "\"Элемент индекса - на основе значений кривой",
  "properties": {
    "id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Идентификатор объекта",
      "title": "Id",
      "ui:hidden": true
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "slug": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Системное имя или код объекта (только английский)",
      "title": "Slug",
      "ui:property_priority": 2
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "uom": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Единицы измерения",
      "title": "Uom"
    },
    "cumulative": {
      "anyOf": [
        {
          "$ref": "#/$defs/CumulativeRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "опциональная кумулятивная агрегация. Для налогов. Пока не реализовываем."
    },
    "type": {
      "const": "curveref",
      "default": "curveref",
      "description": "Тип элемента формулы - значение на основе кривых",
      "enum": [
        "curveref"
      ],
      "title": "Type",
      "type": "string"
    },
    "curves": {
      "default": [],
      "description": "Список кривых, откуда берется значение (в порядке приоритета выбора)",
      "items": {
        "type": "string"
      },
      "title": "Curves",
      "type": "array"
    },
    "aggregation": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "fixed_range": "#/$defs/FixedDatesAveragingRule",
              "none": "#/$defs/EmptyAveragingRule",
              "offset": "#/$defs/OffsetAveragingRule"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OffsetAveragingRule"
            },
            {
              "$ref": "#/$defs/FixedDatesAveragingRule"
            },
            {
              "$ref": "#/$defs/EmptyAveragingRule"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Параметры вычисления на основе совокупности значений",
      "title": "Aggregation"
    },
    "delta": {
      "default": 0.0,
      "description": "Фиксировнная премия (добавляется к вычисленному значению)",
      "title": "Delta",
      "type": "number"
    },
    "calendar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Календарь. Используется при определении дней, за которые будет производится расчет при агрегации.\nЕсли не указан - производится отбор значений из кривых по всем отчетным дням, достпным в кривой.\nЕсли указан - берется за дни - пересечение календарей кривой и данного элемента.",
      "title": "Calendar"
    }
  },
  "title": "CurveElementModel",
  "type": "object"
}