        "priority": 2
      },
      "ui:property_priority": 2
    },
    "pricing": {
      "description": "Условия ценообразования",
      "items": {
        "discriminator": {
          "mapping": {
            "fixed": "#/$defs/FixedPricingModel",
            "index": "#/$defs/IndexPricingModel",
            "individual_agreement": "#/$defs/IndividualContractPricingModel"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/IndexPricingModel"
          },
          {
            "$ref": "#/$defs/FixedPricingModel"
          },
          {
            "$ref": "#/$defs/IndividualContractPricingModel"
          }
        ]
      },
      "title": "Pricing",
      "type": "array",
      "ui:tab": true
    },
    "pricing_mode": {
      "allOf": [
        {
          "$ref": "#/$defs/ContractPricingMode"
        }
      ],
      "default": "price_amendments",
      "description": "Порядок действия правил ценообразования.\nА) AMENDMENTS - Начальные и доп. соглашения по цене и на объем сверх стандартного,\nБ) INDIVIDUAL_CONTRACTS - независимые подконтракты (для контрактов трейдинга, EFET)"
    },
