      "title": "Slug",
      "ui:property_priority": 2
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Описание объекта",
      "title": "Description",
      "ui:property_priority": 3
    },
    "type": {
