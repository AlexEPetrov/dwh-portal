          "title": "Fwd Data Source"
        },
        "fwd_data_source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Пока не заполнять",
          "title": "Fwd Data Source Type"
        },
        "fwd_data_params": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
