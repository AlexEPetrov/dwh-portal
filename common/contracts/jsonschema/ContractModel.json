      "type": "boolean",
      "ui:group": {
        "name": "Версия",
        "priority": 100
      },
      "ui:property_priority": 6
    },
    "tag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
