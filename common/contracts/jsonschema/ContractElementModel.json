      "enum": [
        "value",
        "value_rub",
        "value_usd",
        "payment_amount",
        "payment_amount_rub",
        "payment_amount_usd",
        "payment_volume",
        "volume"
      ],
      "title": "Property",
      "type": "string"
    }
