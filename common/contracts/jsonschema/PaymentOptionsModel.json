{
  "$defs": {
    "OffsetUnit": {
      "description": "Варианты сдвига по дате",
      "enum": [
        "calendar_day",
        "business_day",
        "month",
        "quarter",
        "year"
      ],
      "title": "OffsetUnit",
      "type": "string"
    }
  },
  "description": "Параметры платежей по контракту",
  "properties": {
    "id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Идентификатор объекта",
      "title": "Id",
      "ui:hidden": true
    },
    "payment_period": {
      "default": "month",
      "description": "Платежный период (month или day). При формировании точной даты платежа\nотталкиваемся от начала или конца периода (для опции day - они совпадают)",
      "title": "Payment Period",
      "type": "string"
    },
    "prepayment_date_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Сдвиг даты предварительного платежа относительно начала платежного периода",
      "title": "Prepayment Date Offset"
    },
    "prepayment_date_offset_unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/OffsetUnit"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UOM сдвига даты предварительного платежа относительно начала платежного периода"
    },
    "prepayment_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Абс. значение предварительного платежа (константа).",
      "title": "Prepayment Value"
    },
    "prepayment_percentage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Относительное значение предварительного платежа (процент).",
      "title": "Prepayment Percentage"
    },
    "final_payment_date_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Сдвиг даты финального платежа относительно конца платежного периода",
      "title": "Final Payment Date Offset"
    },
    "final_payment_date_offset_unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/OffsetUnit"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UOM сдвига даты финального платежа относительно конца платежного периода"
    },
    "final_payment_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Абс. значение финального платежа (константа).",
      "title": "Final Payment Value"
    },
    "final_payment_percentage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Относительное значение финального платежа (процент).",
      "title": "Final Payment Percentage"
    }
  },
  "title": "PaymentOptionsModel",
  "type": "object"
}