!backend/core-service/duckdb_extensions/**
!infra/
!infra/images/
!infra/images/portal-harness/
!infra/images/portal-harness/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/.git
**/.venv
**/node_modules
**/dist
**/frontend-dist
**/__pycache__
**/*.pyc
**/*.pyo
