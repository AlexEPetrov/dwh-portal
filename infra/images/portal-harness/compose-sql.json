{
    "services": {
        "portal-harness": {
            "image": "134/dwh-portal-dsh:0.2.2-rc.5-source-experimental",
            "init": true,
            "restart": "unless-stopped",
            "env_file": [
                "${PORTAL_ENV_FILE:?Pass the existing Portal environment file}"
            ],
            "environment": {
                "APP_PORTAL_STORE": "sql",
                "APP_PORTAL_SEED_DEMO": "false",
                "APP_PORTAL_RESET_ON_COLLECT": "false",
                "APP_API_PORT": "5051",
                "APP_DB_PSG_HOST": "${APP_DB_PSG_HOST:?Existing Portal DB host is required}",
                "APP_DB_PSG_PORT": "${APP_DB_PSG_PORT:-5432}",
                "APP_DB_PSG_DB": "${APP_DB_PSG_DB:?Existing Portal DB name is required}",
                "APP_DB_PSG_USER": "${APP_DB_PSG_USER:?Existing Portal DB user is required}",
                "APP_DB_PSG_PASS": "${APP_DB_PSG_PASS:?Existing Portal DB password is required}",
                "DSH_PORT": "3080",
                "DSH_PUBLIC_URL": "${DSH_PUBLIC_URL:-http://127.0.0.1:3080/}"
            },
            "ports": [
                "127.0.0.1:${PORTAL_HARNESS_HOST_PORT:-5053}:5051",
                "127.0.0.1:${DSH_HOST_PORT:-3080}:3080"
            ],
            "volumes": [
                "dsh-state:/var/lib/dsh"
            ],
            "extra_hosts": [
                "host.docker.internal:host-gateway"
            ],
            "networks": [
                "existing-portal"
            ]
        }
    },
    "volumes": {
        "dsh-state": {}
    },
    "networks": {
        "existing-portal": {
            "external": true,
            "name": "dwh_portal"
        }
    }
}
