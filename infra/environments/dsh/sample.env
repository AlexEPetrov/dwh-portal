# DSH-only machine. Do not copy Portal DB/auth/source configuration here.
# REQUIRED: actual Portal Streamable HTTP MCP endpoint, including its MCP path.
# No default remote address; no embedded username/password, query or fragment.
DSH_PORTAL_MCP_URL=
# Credential reference NAME only. Provision the token in DSH's credential provider.
# Do not put a bearer token in this field or in the URL.
DSH_PORTAL_MCP_CREDENTIAL=

# Published on host loopback only. Public URL must match the actual browser origin.
DSH_HOST_PORT=3080
DSH_PUBLIC_URL=http://127.0.0.1:3080/
# Empty selects the concrete container IPv4 address; never use 0.0.0.0.
DSH_BIND_HOST=
# ollama disables built-in public inference; no model/cloud fallback when unset.
DSH_PROVIDER_MODE=ollama
# Set both the actual internal OpenAI-compatible /v1 URL and installed model ID.
DSH_OLLAMA_BASE_URL=
DSH_OLLAMA_MODEL=
DSH_OLLAMA_CONTEXT_WINDOW=8192
DSH_OLLAMA_MAX_TOKENS=2048
DSH_OLLAMA_API_KEY=ollama
