# Target-environment settings for DWH Portal core-service.
# Copied into .build/<env>/ by infra/scripts/_build_target.sh and interpolated by docker compose.

ENVIRONMENT=test

#============== HTTP =========================

APP_API_HOST=0.0.0.0
APP_API_PORT=5051
APP_API_HOST_PORT=5052

#============== PORTAL STORE =================

APP_PORTAL_STORE=sql
APP_PORTAL_SEED_DEMO=false
APP_PORTAL_RESET_ON_COLLECT=false
APP_PORTAL_STALE_AFTER_HOURS=36
APP_PORTAL_LINEAGE_MAX_DEPTH=8
APP_PORTAL_DEFAULT_PAGE_SIZE=50
APP_PORTAL_MAX_PAGE_SIZE=200

#============== APP DB (portal SQL) ==========

APP_DB_PSG_HOST=host.docker.internal
APP_DB_PSG_PORT=5432
APP_DB_PSG_DB=app_gtrm
APP_DB_PSG_USER=postgres
APP_DB_PSG_PASS=postgres

#============== DWH (collectors, read-only) ==

APP_DWH_PSG_HOST=host.docker.internal
APP_DWH_PSG_PORT=5432
APP_DWH_PSG_DB=dwh
APP_DWH_PSG_USER=postgres
APP_DWH_PSG_PASS=postgres
APP_DWH_CONNECTION_IDENTITY=dwh
APP_DWH_REST_METADATA_TIMEOUT_SECONDS=3.0
APP_DWH_REST_METADATA_RETRIES=1
APP_DWH_LINEAGE_ADAPTERS=postgres_sql,extraction_registry,python_modules,airflow_dags
APP_DWH_AIRFLOW_DAGS_ROOT=/app/dags_code
APP_DWH_AIRFLOW_LINEAGE_MODE=catalog
APP_DWH_PYTHON_MODULES_ROOT=/app/loaders_code
APP_DWH_PYTHON_MODULES_LINEAGE_MODE=catalog

#============== AUTH ========================

APP_AUTH_SESSION_COOKIE_NAME=app_session
APP_AUTH_SESSION_TTL_SECONDS=28800
APP_AUTH_SESSION_SECRET_KEY=dev-auth-secret-change-me
APP_AUTH_SESSION_SECURE_COOKIE=false
APP_AUTH_SESSION_SAMESITE=lax
APP_AUTH_LOCAL_USERNAME=dev
APP_AUTH_LOCAL_PASSWORD=dev
APP_AUTH_VIEWER_USERNAME=viewer
APP_AUTH_VIEWER_PASSWORD=viewer
APP_AUTH_SERVICE_API_KEYS=0000,dev

#============== AI ==========================

APP_AI_ENABLED=false
APP_AI_PROVIDER=openai_compatible
APP_AI_BASE_URL=http://host.docker.internal:8080/v1
APP_AI_API_KEY=
APP_AI_MODEL=qwen2.5-coder:14b
APP_AI_TIMEOUT_SEC=600

#============== HOST PATHS (bind mounts) ====

APP_LOC_REPOSITORY_PATH_HOST=/app/local_storage
APP_LOC_LOGS_PATH_HOST=/app/logs
APP_LOC_SRC_HOST=./src
APP_LOC_WHEELS_HOST=/app/wheels
APP_DWH_AIRFLOW_DAGS_ROOT_HOST=/app2/dags_code
APP_DWH_PYTHON_MODULES_ROOT_HOST=/app2/loaders_code
