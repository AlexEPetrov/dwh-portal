# Public DEVELOPMENT template for the Portal test environment, not credentials.
# Shared section names/order match ../portal-harness/sample.env. The harness
# example additionally documents MCP and DSH. Provision actual values privately;
# this file does NOT copy the operator's existing test .env or its secrets.
# Local mounts must refer to real target paths before this Compose can start.

# === 1. Process and HTTP ===
# The API entry point binds all container IPv4 interfaces; APP_API_HOST is a
# legacy Compose input, not an effective runtime bind override.
ENVIRONMENT=test
APP_API_HOST=0.0.0.0
APP_API_PORT=5051
APP_API_HOST_PORT=5052

# === 2. Portal snapshot store ===
APP_PORTAL_STORE=sql
APP_PORTAL_SEED_DEMO=false
APP_PORTAL_RESET_ON_COLLECT=false
APP_PORTAL_STALE_AFTER_HOURS=36
APP_PORTAL_LINEAGE_MAX_DEPTH=8
APP_PORTAL_DEFAULT_PAGE_SIZE=50
APP_PORTAL_MAX_PAGE_SIZE=200

# === 3. Portal database ===
# host-gateway resolves the Docker host; localhost would mean this container.
# A reachable PostgreSQL with current Portal schema is required. No automatic
# migration application occurs. Use a dedicated account in a real deployment.
APP_DB_PSG_HOST=host.docker.internal
APP_DB_PSG_PORT=5432
APP_DB_PSG_DB=dwh
APP_DB_PSG_USER=postgres
APP_DB_PSG_PASS=postgres
# Test Compose enumerates env keys rather than forwarding this entire file.
# Unlike harness, these optional ORM keys are not currently passed through:
# APP_DB_ORM_DEBUG_MODE=false
# APP_DB_ORM_PRE_PING=false
# APP_DB_ORM_POOL_RECYCLE=3600

# === 4. DWH and lineage ===
# Optional read-only DWH target, distinct from Portal's snapshot DB above.
# Empty host/database leaves DWH unconfigured; no app-DB credential fallback.
APP_DWH_PSG_HOST=
APP_DWH_PSG_PORT=5432
APP_DWH_PSG_DB=
APP_DWH_PSG_USER=
APP_DWH_PSG_PASS=
APP_DWH_CONNECTION_IDENTITY=dwh
APP_DWH_REST_METADATA_TIMEOUT_SECONDS=3.0
APP_DWH_REST_METADATA_RETRIES=1
# Empty selects postgres_sql,extraction_registry,airflow_dags. Add python_modules
# explicitly only after provisioning its roots/mounts. Sources are AST-read only.
APP_DWH_LINEAGE_ADAPTERS=
# The existing test Compose always declares the Airflow/Python bind mounts.
# Provision BOTH host and container path variables below before starting it;
# empty values here are placeholders, not a ready-to-launch mount configuration.
APP_DWH_AIRFLOW_DAGS_ROOT=
APP_DWH_AIRFLOW_LINEAGE_MODE=catalog
APP_DWH_PYTHON_MODULES_ROOT=
APP_DWH_PYTHON_MODULES_LINEAGE_MODE=catalog

# === 5. Portal authentication ===
# PUBLIC development values only. Replace secrets/passwords/service keys in
# private configuration. Secure cookies require an approved HTTPS deployment.
APP_AUTH_SESSION_COOKIE_NAME=app_session
APP_AUTH_SESSION_TTL_SECONDS=28800
APP_AUTH_SESSION_SECRET_KEY=dev-auth-secret-change-me
APP_AUTH_SESSION_SECURE_COOKIE=false
APP_AUTH_SESSION_SAMESITE=lax
APP_AUTH_LOCAL_USERNAME=dev
APP_AUTH_LOCAL_PASSWORD=dev
APP_AUTH_VIEWER_USERNAME=viewer
APP_AUTH_VIEWER_PASSWORD=viewer
APP_AUTH_SERVICE_API_KEYS=0000,dev

# === 6. Portal AI (legacy) ===
# Separate integration/stub, not DSH. Disabled by default; these settings do not
# create an Ollama service, install a model or enable automatic cloud fallback.
APP_AI_ENABLED=false
APP_AI_PROVIDER=ollama
APP_AI_BASE_URL=http://ollama:11434
APP_AI_API_KEY=
APP_AI_MODEL=llama3.1:8b
APP_AI_TIMEOUT_SEC=600

# === 7. Local paths and mounts ===
# Set these to existing absolute paths on the TARGET host before use. Blanks
# are deliberately not invented host paths. Test Compose requires its declared
# logs/repository/Airflow/Python mounts even when collection is not requested.
APP_LOC_REPOSITORY_PATH_HOST=
APP_LOC_LOGS_PATH_HOST=
# Used by the test development source overlay; a transferred release embeds src.
APP_LOC_SRC_HOST=
# Also consumed by the test development overlay as its /wheels bind mount.
APP_LOC_WHEELS_HOST=
APP_DWH_AIRFLOW_DAGS_ROOT_HOST=
APP_DWH_PYTHON_MODULES_ROOT_HOST=
# Ordinary Portal keeps MCP disabled by application defaults. This test Compose
# does not forward arbitrary MCP/DSH variables; use harness for that profile.
