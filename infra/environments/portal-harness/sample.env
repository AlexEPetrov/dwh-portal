# Complete Portal + DSH development sample. Copy to a private, untracked file
# before supplying real credentials. Never commit passwords, keys or tokens here.
# Common section names/order match the test environment; sections 8-9 add harness
# capabilities. This file is parsed by Compose, not sourced by a shell.
# Development credentials below are PUBLIC examples, not a secure deployment.
# Restart/recreate the service after changing its launch configuration.

# === 1. Process and HTTP ===
# portal starts only Portal; all starts Portal and DSH. Recreate after changing.
# DSH stays installed and its state is retained. MCP is controlled in section 8,
# independently of DSH. Compose defaults to portal when this value is unset.
PORTAL_LAUNCH_MODE=portal
# Portal binds all container IPv4 interfaces; its launcher ignores APP_API_HOST.
# APP_API_PORT=5051 and DSH_PORT=3080 are fixed by the harness Compose definition;
# changing only those values here does NOT change the deployed listen ports.
APP_API_PORT=5051
# Unlike test's APP_API_HOST_PORT, this variable controls Portal host publication.
# Compose always publishes on host loopback. A remote deployment needs separate
# approved TLS/reverse-proxy/access configuration, not a wildcard bind here.
PORTAL_HARNESS_HOST_PORT=5053
# Compose-only network allocation; reserve this range on the target first.
# Check other Docker networks and LAN/VPN routes for overlaps. Change both
# values together for another target; gateway must belong to the subnet.
# Recreating the project network is required to change these settings.
# These are NOT the PostgreSQL host address or a fixed container address.
PORTAL_HARNESS_SUBNET=172.22.0.0/16
PORTAL_HARNESS_GATEWAY=172.22.0.1
PYTHONDONTWRITEBYTECODE=1

# === 2. Portal snapshot store ===
# These three store/seed/reset values are pinned by harness Compose as below.
# Reading snapshots does not scan DWH or start collection. Collection is a
# separate explicit operation; there is no automatic refresh on chat startup.
APP_PORTAL_STORE=sql
APP_PORTAL_SEED_DEMO=false
APP_PORTAL_RESET_ON_COLLECT=false
APP_PORTAL_STALE_AFTER_HOURS=36
APP_PORTAL_LINEAGE_MAX_DEPTH=8
APP_PORTAL_DEFAULT_PAGE_SIZE=50
APP_PORTAL_MAX_PAGE_SIZE=200

# === 3. Portal database ===
# PostgreSQL currently runs on the Docker host. Compose maps this hostname to
# host-gateway and creates a project-owned bridge; no existing deployment needed.
# localhost inside the container is NOT the host. For an internal DB server,
# change host/port/credentials only; no image rebuild or network change is needed.
# Listener, routing, firewall and PostgreSQL access rules must allow this client.
# An empty DB is not ready: current Portal schema/migrations are required.
# Neither the launcher nor the diagnostic applies migrations.
APP_DB_PSG_HOST=host.docker.internal
APP_DB_PSG_PORT=5432
APP_DB_PSG_DB=dwh
APP_DB_PSG_USER=postgres
APP_DB_PSG_PASS=postgres
APP_DB_ORM_DEBUG_MODE=false
APP_DB_ORM_PRE_PING=false
APP_DB_ORM_POOL_RECYCLE=3600

# === 4. DWH and lineage ===
# Optional, distinct from the Portal snapshot DB above. Configure a read-only
# DWH account for collectors and the live extraction-load journal. Host/database
# left empty means no DWH target configured; there is no implicit app-DB fallback.
# Existing snapshots and MCP catalog reads remain usable without this connection.
APP_DWH_PSG_HOST=
APP_DWH_PSG_PORT=5432
APP_DWH_PSG_DB=
APP_DWH_PSG_USER=
APP_DWH_PSG_PASS=
APP_DWH_CONNECTION_IDENTITY=dwh
APP_DWH_REST_METADATA_TIMEOUT_SECONDS=3.0
APP_DWH_REST_METADATA_RETRIES=1
# Empty selects built-ins: postgres_sql,extraction_registry,airflow_dags.
# Add python_modules explicitly only when its source roots are configured/mounted.
APP_DWH_LINEAGE_ADAPTERS=
# Container paths, NOT host paths. This Compose declares both read-only source
# mounts: provision BOTH host/container path pairs before launch, even without collection.
# Modes: catalog (existing snapshot targets) or code (materialize AST targets).
# Source files are statically analyzed, never executed.
APP_DWH_AIRFLOW_DAGS_ROOT=
APP_DWH_AIRFLOW_LINEAGE_MODE=catalog
# This base-compatible mount accepts one Python root, not a semicolon list.
APP_DWH_PYTHON_MODULES_ROOT=
APP_DWH_PYTHON_MODULES_LINEAGE_MODE=catalog

# === 5. Portal authentication ===
# Portal browser/API auth is separate from DSH Web auth and MCP read access.
# Values reproduce public DEVELOPMENT defaults. Replace the signing secret,
# passwords and service keys in your private configuration before non-demo use.
# A service API key is NOT an MCP token and is not a per-user DSH credential.
APP_AUTH_SESSION_COOKIE_NAME=app_session
APP_AUTH_SESSION_TTL_SECONDS=28800
APP_AUTH_SESSION_SECRET_KEY=dev-auth-secret-change-me
# false is for loopback HTTP only; use true with an approved HTTPS deployment.
APP_AUTH_SESSION_SECURE_COOKIE=false
APP_AUTH_SESSION_SAMESITE=lax
APP_AUTH_LOCAL_USERNAME=dev
APP_AUTH_LOCAL_PASSWORD=dev
APP_AUTH_VIEWER_USERNAME=viewer
APP_AUTH_VIEWER_PASSWORD=viewer
APP_AUTH_SERVICE_API_KEYS=0000,dev

# === 6. Portal AI (legacy) ===
# Separate Portal AI integration/stub, NOT the DSH model route in section 9.
# Leave disabled for harness chat. These inactive application defaults neither
# create an Ollama service nor enable a fallback or install/pull a model.
APP_AI_ENABLED=false
APP_AI_PROVIDER=ollama
APP_AI_BASE_URL=http://ollama:11434
APP_AI_API_KEY=
APP_AI_MODEL=llama3.1:8b
APP_AI_TIMEOUT_SEC=600

# === 7. Local paths and mounts ===
# Set existing absolute paths on the TARGET host; blanks are not usable mounts.
# Logs are writable/persistent; Airflow/Python sources are read-only.
# Repository/local-storage host binding is intentionally absent in this profile.
APP_LOC_LOGS_PATH_HOST=
APP_DWH_AIRFLOW_DAGS_ROOT_HOST=
APP_DWH_PYTHON_MODULES_ROOT_HOST=
# The launcher selects frontend/web/dist in checkout (must already be built), or
# image-exported frontend-dist beside release scripts. No backend source overlay.
# APP_LOC_SRC_HOST, APP_LOC_WHEELS_HOST, ENVIRONMENT and APP_API_HOST_PORT remain
# unused by this profile. DSH state retains its separate named volume.

# === 8. MCP access and links ===
# Explicit temporary exception: anyone reaching MCP can read catalog metadata.
# Portal/DSH browser login does NOT authenticate these anonymous MCP requests.
APP_MCP_ENABLED=true
APP_MCP_ALLOW_ANONYMOUS_READ=true
# For protected MCP, set anonymous reads false and provision a dedicated token
# privately; an enabled protected interface with an empty token refuses startup.
APP_MCP_TOKEN=
# List settings use JSON arrays, not comma-separated strings. Keep host/origin
# validation enabled. These defaults support the local loopback MCP client.
APP_MCP_ALLOWED_HOSTS='["localhost:*","127.0.0.1:*","[::1]:*"]'
APP_MCP_ALLOWED_ORIGINS='[]'
# Compose maps this public Portal origin to APP_MCP_PUBLIC_BASE_URL; setting
# APP_MCP_PUBLIC_BASE_URL directly in this file is overridden by that mapping.
# Match the actual browser origin when changing the host port above.
PORTAL_HARNESS_PUBLIC_URL=http://127.0.0.1:5053

# === 9. DSH runtime and model ===
# A single-owner experimental Web UI, not Portal-integrated multi-user auth.
# The tokenized launch URL is a credential: never share it unredacted.
DSH_PORT=3080
DSH_HOST_PORT=3080
DSH_PUBLIC_URL=http://127.0.0.1:3080/
# Empty auto-selects the concrete container IPv4 address. Never use 0.0.0.0.
DSH_BIND_HOST=
# Credential reference NAME only, not the MCP token. In protected MCP mode save
# the token in DSH's credentials provider and supply its reference here.
DSH_PORTAL_MCP_CREDENTIAL=
# ollama is the isolated default; upstream explicitly restores public providers.
# A provider profile is not an egress firewall; enforce approved destinations
# separately. Portal DB/auth/token values are not passed to the DSH child.
DSH_PROVIDER_MODE=ollama
# Include /v1 and use an already-installed tool-capable model ID. Both empty
# means UI/MCP only; partial configuration is rejected. No cloud fallback.
# Existing operator-selected values are retained; adapt for another target.
DSH_OLLAMA_BASE_URL=http://192.168.1.111:11435/v1
DSH_OLLAMA_MODEL=ornith_35b
# Current operator-selected capacities, not universal model/server defaults.
# Context includes prompt/history/tools/output; output must be smaller than it.
# These values advertise/request limits in DSH; they do NOT allocate context
# on the server. Configure actual serving capacity separately to match.
DSH_OLLAMA_CONTEXT_WINDOW=40000
DSH_OLLAMA_MAX_TOKENS=30000
# Public placeholder for plain Ollama. Use a dedicated gateway key only in the
# private configuration if your internal endpoint requires authentication.
DSH_OLLAMA_API_KEY=ollama
