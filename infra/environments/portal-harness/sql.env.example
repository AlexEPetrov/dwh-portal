# Example only: public local-development defaults, not production credentials.
# Do not put real passwords into this tracked example.
#
# PostgreSQL currently runs on the Docker host. The supplied Compose maps this
# hostname to the host gateway and creates its own project-scoped bridge network.
# localhost inside the Portal container would refer to the container, not the host.
# Later, for PostgreSQL on another server inside the contour, replace ONLY the
# host below with that server's actual internal DNS name/IP (plus port if needed).
# No Docker network change or image rebuild is required for that transition.
APP_DB_PSG_HOST=host.docker.internal
APP_DB_PSG_PORT=5432
APP_DB_PSG_DB=dwh
APP_DB_PSG_USER=postgres
APP_DB_PSG_PASS=postgres

# Read existing Portal snapshots; do not seed/reset the SQL catalog.
# An empty PostgreSQL database is not ready: Portal requires its existing
# schema/migrations to be current. The launcher does not apply migrations.
APP_PORTAL_STORE=sql
APP_PORTAL_SEED_DEMO=false
APP_PORTAL_RESET_ON_COLLECT=false

# Explicit temporary exception: anyone who reaches MCP can read its metadata.
APP_MCP_ENABLED=true
APP_MCP_ALLOW_ANONYMOUS_READ=true

# Browser origins and loopback-only host publication used by run-sql.sh.
PORTAL_HARNESS_HOST_PORT=5053
PORTAL_HARNESS_PUBLIC_URL=http://127.0.0.1:5053
DSH_HOST_PORT=3080
DSH_PUBLIC_URL=http://127.0.0.1:3080/

# No MCP token is required in anonymous-read mode.
# Runtime provider profile: ollama (isolated default) or upstream (public providers).
# No external provider model-list refresh is enabled in ollama mode.
DSH_PROVIDER_MODE=ollama

# Configure both values manually to enable inference. Include /v1 in the
# internal Ollama OpenAI-compatible URL and use an already-installed model ID.
# Both empty means UI/MCP only: no model route and no automatic cloud fallback.
DSH_OLLAMA_BASE_URL=http://192.168.1.111:11435/v1
DSH_OLLAMA_MODEL=ornith_35b

# Set these to the actual model/server capacity; these are conservative examples,
# not a claim about the selected model or a change to Ollama's server settings.
DSH_OLLAMA_CONTEXT_WINDOW=8192
DSH_OLLAMA_MAX_TOKENS=2048
